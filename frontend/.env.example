# Copy to .env.local (git-ignored) and edit. All VITE_* values are baked into the
# browser bundle at build time, so never put secrets here.

# Base URL of the Laptop 1 FastAPI server. Use Laptop 1's LAN IPv4 address.
# Leave empty to configure it from the UI (Connection button) instead.
VITE_API_BASE_URL=http://192.168.1.20:8000

# Timeout for /health and /evaluation/trips requests (ms).
VITE_API_TIMEOUT_MS=10000

# Overall timeout for one evaluation run, including polling (ms).
VITE_EVALUATION_TIMEOUT_MS=180000

# Poll interval when the backend answers POST /evaluation/run with queued/running (ms).
VITE_POLL_INTERVAL_MS=1500

# DEVELOPMENT ONLY: comma-separated trip IDs shown in the selector when the
# backend trip list cannot be loaded. Ignored in production builds and always
# labelled as fallback in the UI. Runs still go to the real backend.
VITE_DEV_FALLBACK_TRIPS=

# Optional CORS-free fallback (read by vite.config.ts, not sent to the browser):
# set VITE_API_BASE_URL=/api and point this at Laptop 1.
# PATHSNAP_PROXY_TARGET=http://192.168.1.20:8000
